# Upload only the API, its dependencies and build configuration.
# Extension source, datasets, documentation, reports and tests stay local.
*
!api
!api/**
!server
!server/**
!shared
!shared/**
!compute
!compute/**
!pyproject.toml
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.server.json
!vercel.json
!vitest.server.config.mts
!drizzle.config.ts
# Local secrets and future raw datasets are never deployment inputs.
.env*
**/*.csv
**/*.tsv
**/__pycache__/**

# Explicitly staged private deployment artifacts, never extension inputs.
!.private
!.private/rental
!.private/rental/*.json
