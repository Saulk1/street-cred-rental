{
  "name": "microburbs-facts-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Microburbs Facts Chrome extension",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "dev:api": "node --env-file-if-exists=.env.local ./node_modules/vercel/dist/vc.js dev --listen 3000",
    "dev:compute": "node scripts/dev-compute.mjs",
    "test:compute": "python3 -m unittest discover -s tests -p 'compute_test.py'",
    "test:server": "vitest run --config vitest.server.config.mts",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:ui": "vitest run",
    "test:package": "python3 scripts/verify-package.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.70.0",
    "openai": "^7.53.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "0.31.11",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vercel": "65.12.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
