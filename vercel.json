{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck:server",
  "outputDirectory": "server/public",
  "functions": {
    "api/compute.py": {
      "maxDuration": 10,
      "excludeFiles": "{node_modules/**,tests/**,extension/**,data/**,docs/**,reports/**,dist/**,.build/**,.tools/**}",
      "includeFiles": ".private/rental/*.json"
    },
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/rental.ts": {
      "maxDuration": 30
    }
  }
}
