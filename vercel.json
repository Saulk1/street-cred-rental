{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck:server",
  "outputDirectory": "server/public",
  "functions": {
    "api/compute.py": {
      "maxDuration": 10,
      "excludeFiles": "{node_modules/**,tests/**,assets/**,dist/**,src/**,.build/**,.tools/**}"
    },
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}
